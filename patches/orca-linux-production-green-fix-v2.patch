diff --git a/resources/linux/packaging/after-remove.sh b/resources/linux/packaging/after-remove.sh
index 83d30b02..3277914f 100755
--- a/resources/linux/packaging/after-remove.sh
+++ b/resources/linux/packaging/after-remove.sh
@@ -7,6 +7,8 @@ case "${1-}" in
   *) exit 0 ;;
 esac
 
+link="/usr/bin/orca-ide"
+
 if command -v systemctl >/dev/null 2>&1; then
   systemctl --global disable orca-hardened-gc.timer >/dev/null 2>&1 || true
 fi
@@ -24,8 +26,13 @@ remove_owned_link() {
 for unit in orca-hardened.slice orca-hardened-gc.service orca-hardened-gc.timer; do
   remove_owned_link "/usr/lib/systemd/user/$unit"
 done
-for command in orca-hardened orca-hardened-doctor orca-hardened-gc orca-ide; do
-  remove_owned_link "/usr/bin/$command"
+for managed_link in \
+  "$link" \
+  /usr/bin/orca-hardened \
+  /usr/bin/orca-hardened-doctor \
+  /usr/bin/orca-hardened-gc
+do
+  remove_owned_link "$managed_link"
 done
 
 exit 0
